# ── Required ──────────────────────────────────────────────────────────────────
VAULT_PASSWORD=change-me
# openssl rand -hex 32
HMAC_KEY=dev-key-replace-in-production

# ── Storage: Cloudflare R2 (recommended) ──────────────────────────────────────
# Leave these blank to store on local disk instead (fine for local development).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=bubble-vault
# R2_PUBLIC_BASE=https://img.yourdomain.com

# ── Paths (Railway: point both at a mounted Volume) ───────────────────────────
# DATA_DIR=/data
# UPLOAD_DIR=/data/uploads

# ── Your public domain, so server actions accept its origin ───────────────────
# PUBLIC_HOST=vault.yourdomain.com

# ── Keep image URLs stable when replacing a file (recommended) ────────────────
# Objects are served with a one-year immutable cache, so overwriting one leaves
# Cloudflare serving the old bytes for months. With these set, the app purges
# the edge instead of writing to a new key — so a resized or deleted image keeps
# (or properly loses) its existing URL and nothing embedded elsewhere breaks.
#
# Token: Cloudflare → My Profile → API Tokens → Create Token → Custom token
#        Permission: Zone → Cache Purge → Purge
#        Zone Resources: Include → your domain
# Zone ID: on the domain's Overview page, right-hand column.
# CF_ZONE_ID=
# CF_PURGE_TOKEN=

# ── Catalog location (optional) ───────────────────────────────────────────────
# Derived from the R2 secret by default, so every machine with the credentials
# agrees on it. Pin it explicitly if you ever rotate the R2 API token.
# VAULT_CATALOG_KEY=_catalog/mine.json
