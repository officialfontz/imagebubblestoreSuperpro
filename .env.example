# ── Required ──────────────────────────────────────────────────────────────────
VAULT_PASSWORD=change-me
# openssl rand -hex 32
HMAC_KEY=dev-key-replace-in-production

# ── Storage: Cloudflare R2 (recommended) ──────────────────────────────────────
# Leave these blank to store on local disk instead (fine for local development).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=bubble-vault
# R2_PUBLIC_BASE=https://img.yourdomain.com

# ── Paths (Railway: point both at a mounted Volume) ───────────────────────────
# DATA_DIR=/data
# UPLOAD_DIR=/data/uploads

# ── Your public domain, so server actions accept its origin ───────────────────
# PUBLIC_HOST=vault.yourdomain.com
